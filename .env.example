# OPTIONAL. You can paste your key on the "AI Key Setup" page instead (it is then saved in the database).
# Use a .env key only if you prefer files. Any provider works: Gemini (free), Groq (free), OpenAI, Claude, ...
AI_API_KEY=
# AI_PROVIDER=gemini      # optional: gemini, groq, openrouter, openai, anthropic, custom (auto-detected from the key)
# AI_MODEL=               # optional: override the default model name
# AI_BASE_URL=            # only for provider "custom"
SECRET_KEY=change-this-to-any-random-text
